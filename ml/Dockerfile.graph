# ml/Dockerfile.graph - hourly graph feature job. Build from the repo root.
FROM python:3.12-slim
WORKDIR /app
COPY ml/requirements-graph.txt .
RUN pip install --no-cache-dir -r requirements-graph.txt
COPY ml/src /app/ml/src
ENV PYTHONPATH=/app/ml/src
CMD ["python", "-m", "aegis_ml.features.graph_features"]
